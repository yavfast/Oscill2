# Serial/transport settings
OSCILL_PORT=/dev/ttyUSB0
OSCILL_BAUD=9600
OSCILL_SPEED_COEF=0x10            # 0x10 -> 115200 (speed = 1842000 / coef)

# OBEX settings
OBEX_USE_CHECKSUM=true            # enable header 0xB0 checksum
OBEX_REQUEST_TIMEOUT_MS=2000
OBEX_RESEND_ON_ERROR=true

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Streaming/visualization
WS_MAX_FPS=60
FRAME_MAX_SAMPLES=8192            # server-side downsampling limit
